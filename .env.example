# Copied to .env by `make up` with fresh random tokens. Never commit .env.
CSTAM_ADMIN_TOKEN=change-me-admin-token-0000
CSTAM_VIEWER_TOKEN=change-me-viewer-token-000
CSTAM_GATEWAY_TOKEN=change-me-gateway-token-00
POSTGRES_PASSWORD=cstam

# IP quarantine before reuse: 60s in production, 10s makes recycling visible in a demo
QUARANTINE=10s
CPD_WORKERS=4

# frontend image: app = build inside Docker (default); prebuilt = use frontend/dist that you
# built on your machine (cd frontend && npm ci && npm run build), when npm times out in Docker
FRONTEND_TARGET=app

# host ports
FRONTEND_PORT=8080
CPD_PORT=8443
EDGE_PORT=8000

# hackathon used by scripts/demo.sh (team URLs: http://<team>.<HACK>.localhost:8000)
HACK=demo

# FelCloud mode only (make felcloud-ids fills the three IDs, read-only)
OS_CLOUD=cstam
# OS_CLOUDS_YAML=/home/you/.config/openstack/clouds.yaml   (default: ~/.config/openstack/clouds.yaml)
CSTAM_NETWORK_ID=
CSTAM_SUBNET_ID=
CSTAM_TEAM_SG_ID=
